# Dockerfile para Frontend React - WebApp Análise de Crédito
# Desenvolvimento overnight para impressionar Lucas

FROM node:18-alpine

# Metadados
LABEL maintainer="Jarvis Assistant"
LABEL description="Frontend React para Sistema de Análise de Crédito"
LABEL version="1.0.0-overnight"

# Diretório de trabalho
WORKDIR /app

# Copiar package files
COPY package*.json ./

# Instalar dependências
RUN npm ci --only=production --silent

# Copiar código fonte  
COPY . .

# Expor porta
EXPOSE 3000

# Saúde do container
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3000 || exit 1

# Comando para desenvolvimento
CMD ["npm", "start"]