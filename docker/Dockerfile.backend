# Dockerfile para Backend Node.js - WebApp Análise de Crédito  
# Desenvolvimento overnight para impressionar Lucas

FROM node:18-alpine

# Metadados
LABEL maintainer="Jarvis Assistant" 
LABEL description="Backend Node.js para Sistema de Análise de Crédito"
LABEL version="1.0.0-overnight"

# Instalar dependências do sistema
RUN apk add --no-cache curl

# Diretório de trabalho
WORKDIR /app

# Copiar package files
COPY package*.json ./

# Instalar dependências
RUN npm ci --only=production --silent

# Copiar código fonte
COPY . .

# Build TypeScript
RUN npm run build

# Criar usuário não-root para segurança
RUN addgroup -g 1001 -S nodejs && \
    adduser -S jarvis -u 1001

# Mudar ownership
RUN chown -R jarvis:nodejs /app
USER jarvis

# Expor porta
EXPOSE 5000

# Saúde do container
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:5000/health || exit 1

# Comando para produção
CMD ["npm", "start"]