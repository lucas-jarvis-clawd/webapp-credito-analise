# Configurações do servidor
PORT=3001
NODE_ENV=development

# Configurações do Oracle Database
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE_NAME=xe
DB_USER=credito_user
DB_PASSWORD=credito_pass

# JWT
JWT_SECRET=seu_jwt_secret_muito_secreto_aqui
JWT_EXPIRES_IN=24h

# Configurações do sistema de scoring
SCORE_MIN=0
SCORE_MAX=1000
SCORE_DEFAULT_WEIGHTS_PONTUACAO=0.3
SCORE_DEFAULT_WEIGHTS_HISTORICO=0.25
SCORE_DEFAULT_WEIGHTS_VALOR=0.25
SCORE_DEFAULT_WEIGHTS_PRAZO=0.2